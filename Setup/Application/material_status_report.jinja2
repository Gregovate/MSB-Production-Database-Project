<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>MSB Setup Production Report</title>
<style>
body{font:16px/1.45 Arial,sans-serif;color:#17212b;background:#fff;margin:0 auto;padding:24px;max-width:1100px}h1{margin:0}h2{border-bottom:2px solid #315765;padding-bottom:6px;margin-top:30px}h3{margin:0 0 8px}.muted{color:#53616c}.notice{border-left:5px solid #b07800;background:#fff6dc;padding:12px;margin:16px 0}.summary{display:flex;flex-wrap:wrap;gap:18px;padding:12px;background:#eaf1f4}.summary strong{display:block;font-size:25px}a{color:#14576d}button,input{font:inherit;padding:8px}.toolbar{display:flex;flex-wrap:wrap;gap:14px;align-items:center}.container{border:1px solid #aebbc1;border-radius:8px;padding:16px;margin:16px 0}.trail{padding-left:24px}.trail li{margin:12px 0}.new{border-left:4px solid #18744a;padding-left:10px}.names{margin:6px 0;padding-left:22px}.location{font-weight:bold}table{width:100%;border-collapse:collapse}th,td{text-align:left;vertical-align:top;padding:8px;border-bottom:1px solid #cbd4d8;overflow-wrap:anywhere}th{background:#eaf1f4}small{font-size:13px}.tag{font-size:13px;font-weight:bold;color:#155e3b}details{margin:12px 0}summary{cursor:pointer;font-weight:bold}.unresolved{padding:12px 0;border-bottom:1px solid #cbd4d8}p{margin:8px 0}@media print{body{font-size:11px;padding:0;max-width:none}.toolbar{display:none}h2{break-after:avoid}.container{border-radius:0}.trail li,.unresolved,tr{break-inside:avoid}th{display:table-cell}thead{display:table-header-group}a{color:inherit;text-decoration:none}.notice,.summary,th{background:white}.container h3{break-after:avoid}details:not([open]){display:none}}@page{size:letter;margin:0.55in}
</style></head><body>
<div class="toolbar"><a href="../../../material-status/?season_year={{ material.session.season_year if material.session else '' }}">Back to Material Status</a><button type="button" onclick="window.print()">Print / Save PDF</button><form method="get"><input type="hidden" name="season_year" value="{{ material.session.season_year if material.session else '' }}"><label>Compare after event <input type="number" name="since_event_id" min="0" step="1" value="{{ since_event_id or '' }}" placeholder="e.g. 123" style="width:110px"></label> <button>Generate fresh report</button></form></div>
<h1>MSB Setup — Production Report</h1>
<p>{{ material.session.season_year if material.session else 'No active season' }} · Session {{ material.session.setup_session_id if material.session else 'none' }} · {{ material.session.session_status if material.session else '' }}</p>
<p><strong>Generated {{ generated }}</strong> · Database {{ database_name }} · Synced movement records through event {{ through_event_id }}</p>
<div class="notice">Based on synced records. Unrecorded work and unsynced tablets are absent. Recorded removals show what the system detached; physical removal still needs confirmation. Current contents reflect generation time. Planning can change during generation.</div>
<div class="summary">{% for label,key in [('Picked / moved','picked_moved'),('Scheduled to pick','scheduled_to_pick'),('Unscheduled / pickable','unscheduled_pickable'),('Workshop policy','workshop'),('Unresolved requirements','unresolved')] %}<div>{{ label }}<strong>{{ material.summary[key] or 0 }}</strong></div>{% endfor %}</div>
<p><a href="#unresolved">Unresolved reasons</a> · <a href="#changes">Changes</a> · <a href="#trail">Movement / location trail</a> · <a href="#direct">Direct Display observations</a> · <a href="#planning">Material planning</a></p>
<h2 id="unresolved">Unresolved material requirements — {{ material.unresolved_requirements|length }}</h2>
<p>These are material-authority problems, not a count of missing Containers or mistaken unloads. Review the named task and reason in <a href="../../../material-audit/">Material Audit</a>. Repeated requirement rows may refer to the same task; do not assume this count represents distinct physical items.</p>
{% for row in material.unresolved_requirements %}<div class="unresolved"><strong>{{ row.task_name or row.extra_material_name or 'Unresolved requirement' }}</strong><br>{{ row.stage_key or '' }} {{ row.stage_name or '' }}{% if row.scene_name %} / {{ row.scene_name }}{% endif %}<br>{{ row.message }}{% if row.extra_material_name %}<br>Material: {{ row.extra_material_name }} · {{ row.quantity_required or '' }} {{ row.quantity_uom or '' }}{% endif %}<br><small>Reason: {{ row.requirement_type }} · Task {{ row.setup_task_id or 'season-only' }}</small></div>{% else %}<p>No unresolved material requirements reported.</p>{% endfor %}
{% macro recorded_destination(row) %}Recorded destination: {% if row.stage_key or row.stage_name or row.destination_location_note %}{{ row.stage_key or '' }} {{ row.stage_name or '' }} {{ row.destination_location_note or '' }}{% elif row.gps_latitude is not none and row.gps_longitude is not none %}GPS only (no Stage/name recorded){% else %}No destination recorded{% endif %} · {{ row.gps }}{% endmacro %}
{% macro nearest_line(row) %}{% if row.nearest_reference %}Calculated nearest Stage reference (from recorded GPS): <strong>{{ row.nearest_reference.name }}</strong> · {{ '%.0f'|format(row.nearest_reference.distance_ft) }} ft from reference point{% endif %}{% endmacro %}
{% macro event_line(e) %}
<div><strong>{{ e.observed }} — {{ e.event_type }}</strong> · event {{ e.setup_movement_event_id }} {% if e.new_receipt %}<span class="tag">NEW RECEIPT</span>{% endif %}</div>
<div>{{ recorded_destination(e) }}</div>
{% if e.nearest_reference %}<div>{{ nearest_line(e) }}</div>{% endif %}
<div><strong>Recorded Display removals: {{ e.unloaded_names|length }}</strong>{% if not e.unloaded_names %} — no Display detachment effect recorded; physical load unconfirmed{% endif %}</div>
{% if e.effects %}<ul class="names">{% for d in e.effects %}<li>{{ d.display_name or 'Unnamed Display' }} [{{ d.movement_effect }}]</li>{% endfor %}</ul>{% endif %}
{% if e.review_required %}<div><strong>Contents review flagged at this stop; resolution status unavailable.</strong></div>{% endif %}
<small>Received {{ e.received }} · Recorder {{ e.captured_operator_email or 'not recorded' }} · {{ e.capture_method }}{% if e.offline_captured %} · captured offline{% endif %}</small>
{% if e.notes %}<details><summary>Recorded notes</summary><small>{{ e.notes }}</small></details>{% endif %}
{% endmacro %}
<h2 id="changes">Changes since the earlier report</h2>
{% if since_event_id %}<p>{{ new_events|length }} newly received movement records after event {{ since_event_id }}. This compares receipt IDs, not physical change or observation dates. An offline observation received later can describe earlier work.</p><ol class="trail">{% for e in new_events %}<li class="new">{% if e.container_id %}<strong>C{{ '%03d'|format(e.container_id) }} — {{ e.container_name }}</strong>{% else %}<strong>Direct Display / other observation</strong>{% endif %}{{ event_line(e) }}</li>{% else %}<li>No new movement records in this Session after that event.</li>{% endfor %}</ol>{% else %}<p>Enter <strong>123</strong> above to compare with the October 6 report you supplied. Without a comparison event, the full trail below is shown. Planning/authority changes are not inferred from movement IDs.</p>{% endif %}
<h2 id="trail">Container movement / location trail</h2>
<p>Recorded destination and GPS are saved observation data. Calculated nearest Stage reference is an estimate from that GPS; both are shown together. GPS-only destinations are grouped by their nearest reference. Distance is to a reference point, not a Stage boundary; GPS accuracy and stale/weak fix flags remain visible. Prior named context is shown separately. Home is a storage assignment. Attached and detached lists are current recorded assignments, not historical load totals or physical Empty confirmations.</p>
{% if reference_versions %}<p class="muted"><small>GPS reference set: {{ reference_versions|join(', ') }}. Estimates do not assign a Stage or change recorded locations.</small></p>{% endif %}
{% for c in containers %}<article class="container"><h3>C{{ '%03d'|format(c.container_id) }} — {{ c.container_name }}</h3><div class="location">{{ c.location_group }}</div><p>{{ c.container_type_name or 'Type not recorded' }} · Home {{ c.home_location_code or 'not recorded' }} · Recorded status {{ c.movement_status }} · Current event {{ c.last_movement_event_id }}</p>
{% if c.latest %}<p>{{ recorded_destination(c.latest) }} · observed {{ c.latest.observed }}</p>{% endif %}
{% if c.latest.nearest_reference %}<p>{{ nearest_line(c.latest) }}</p>{% endif %}
{% if c.prior_named_context and not c.latest.destination_location_note %}<p>Prior named context: {{ c.prior_named_context }}. This does not prove the latest GPS fix is at that Stage.</p>{% endif %}
<p><strong>Recorded attached: {{ c.attached|length }} · Recorded detached: {{ c.detached|length }}</strong> · Physical contents unconfirmed.</p>
{% if (c.container_type_name == 'Standalone Display' or (c.container_type_name in ['Display Pallet','Display-Pallet'] and c.attached|length + c.detached|length == 1)) and c.detached %}<p><strong>Review: protected Standalone / single-Display Pallet recorded detached; its workflow requires attachment.</strong></p>{% endif %}
{% if c.review_flags %}<p><strong>{{ c.review_flags|length }} historical contents-review flag(s).</strong> Later moves do not establish resolution.</p>{% endif %}
{% if c.attached %}<div>Recorded attached Display Names:</div><ul class="names">{% for d in c.attached %}<li>{{ d.display_name }}</li>{% endfor %}</ul>{% endif %}
{% if c.detached %}<div>Recorded detached Display Names / independent location:</div><ul class="names">{% for d in c.detached %}<li>{{ d.display_name }} — {{ d.stage_key or '' }} {{ d.stage_name or '' }} {{ d.current_location_note or '' }} · {{ d.gps }} · event {{ d.last_movement_event_id or 'not recorded' }}{% if d.nearest_reference %}<br>{{ nearest_line(d) }}{% endif %}</li>{% endfor %}</ul>{% endif %}
<ol class="trail">{% for e in c.history %}<li{% if e.new_receipt %} class="new"{% endif %}>{{ event_line(e) }}</li>{% else %}<li>State exists but no linked movement history was retrieved.</li>{% endfor %}</ol></article>{% else %}<p>No Container movement state recorded for this Session.</p>{% endfor %}
<h2 id="direct">Direct Display / other observations</h2><ol class="trail">{% for e in direct_events %}<li>{{ event_line(e) }}</li>{% else %}<li>No observations outside Container events recorded.</li>{% endfor %}</ol>
<h2 id="planning">Material Status planning / physical items</h2><p>All {{ material['items']|length }} items, regardless of the screen's active filters. Stage/Scene below describes planned demand, not an observed destination. Expected Display material is not proof of current physical contents. Expand to include this table when printing.</p>
<details><summary>Show all material items</summary><table><thead><tr><th>Material / Home</th><th>Status / demand</th><th>Pick By / Needed For</th><th>Planned Stage / Scene, expected material</th></tr></thead><tbody>{% for i in material['items'] %}<tr><td><strong>{{ i.label or i.identity }}</strong><br>{{ i.identity }}<br>Home {{ i.home_location_code or 'not recorded' }}</td><td>{{ i.status }}<br>{{ i.demand_source }}</td><td>{{ i.target_staged_by or 'not planned' }}<br>{{ i.earliest_needed_for_work or 'not scheduled' }}</td><td>{% for r in i.reasons %}<div>{{ r.stage_key or '' }} {{ r.stage_name or '' }}{% if r.scene_name %} / {{ r.scene_name }}{% endif %} · {{ r.task_name or '' }}{% if r.display_names %}<ul class="names">{% for n in r.display_names %}<li>{{ n }}</li>{% endfor %}</ul>{% endif %}{% if r.extra_material_name %}<br>{{ r.extra_material_name }}{% endif %}</div>{% endfor %}</td></tr>{% endfor %}</tbody></table></details>
</body></html>
