# Copy to /etc/msb/lor-preflight-api.env, restrict to root, and replace values.
LOR_PREFLIGHT_DATABASE_URL=postgresql://lor_preflight_app:REPLACE_ME@192.168.5.9/msb
LOR_PREFLIGHT_OPERATORS=operator1@sheboyganlights.org,operator2@sheboyganlights.org

# Existing immutable report publisher settings.
LOR_REPORT_PUBLISHER_PATH=/opt/lor-preflight/publish_lor_reconciliation_report.py
LOR_REPORT_OUTPUT_DIR=/mnt/msb-web/my/lor2db/reports
LOR_REPORT_BASE_URL=https://lortodb.sheboyganlights.org/lor2db/reports
