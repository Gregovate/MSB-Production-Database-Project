# Example only. Do not commit a populated credential file.
# The deployment account should be a dedicated PostgreSQL SELECT-only role.
MSB_PG_DSN=host=127.0.0.1 port=5432 dbname=msb user=msb_mcp_readonly password=CHANGE_ME sslmode=prefer

# Bind only to localhost when tunnel-client runs on the same host.
MSB_MCP_HOST=127.0.0.1
MSB_MCP_PORT=8000
